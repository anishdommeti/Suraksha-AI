<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SURAKSHA AI: Brand dark navy launch window theme (Night) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_navy</item>
        <item name="android:navigationBarColor">@color/splash_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
        <item name="android:statusBarColor">@color/splash_navy</item>
        <item name="android:navigationBarColor">@color/splash_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
